# Public client env
VITE_APP_TITLE=Stagecom
VITE_APP_URL=http://localhost:3000

# Local Supabase defaults are shown here. For the shared remote dev project,
# replace these with the project URL and anon key from Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only env
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Enable only in an isolated local or hosted demo environment. The seed script
# and server-side persona sign-in use the same password.
STAGECOM_DEMO_MODE=false
STAGECOM_DEMO_PASSWORD=

# Optional CLI helper for remote type generation / linking notes.
SUPABASE_PROJECT_ID=
