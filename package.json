{
  "name": "stagecom-react",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "db:start:local": "supabase start --yes",
    "db:status:local": "supabase status",
    "db:stop:local": "supabase stop",
    "db:types": "npm run db:types:remote",
    "db:types:remote": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/server/db/database.types.ts",
    "db:types:local": "npx supabase gen types typescript --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres > src/server/db/database.types.ts",
    "db:types:check:local": "supabase gen types typescript --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres | prettier --parser typescript | diff - src/server/db/database.types.ts",
    "db:link:remote": "npx supabase link --project-ref $SUPABASE_PROJECT_ID",
    "db:reset:local": "npx supabase db reset --local",
    "db:migrate:local": "npx supabase migration up --local",
    "db:migrate:remote": "npx supabase db push",
    "db:seed": "npx supabase db query --local --file supabase/seed.sql",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:seed:remote": "node scripts/seed-demo.mjs --allow-remote",
    "demo:reset": "node scripts/seed-demo.mjs --reset-only",
    "db:test:local": "supabase test db",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.105.1",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "nitro": "npm:nitro-nightly@latest",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "shadcn": "^4.7.0",
    "supabase": "2.109.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
